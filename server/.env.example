NODE_ENV=development
PORT=3000

# Supabase (Postgres) — identities only. Existing config uses the anon key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MongoDB — classes, students, grades, attendance, forms
MONGODB_URI=mongodb://127.0.0.1:27017/homeroom

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated origins are not parsed; set a single allowed origin.
CORS_ORIGIN=http://localhost:5173

# Used by scripts/seedAdmin.js
SEED_ADMIN_USER_ID=123456789
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=School
SEED_ADMIN_LAST_NAME=Admin
