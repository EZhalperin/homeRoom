NODE_ENV=development
PORT=3000

# Supabase (Postgres) — identities only. Prefer the service-role key on the server.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MongoDB — classes, students, grades, attendance, forms
MONGODB_URI=mongodb://127.0.0.1:27017/homeroom
# Optional override; if omitted the database name in MONGODB_URI is used.
# MONGODB_DB_NAME=homeroom

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Single allowed browser origin.
CORS_ORIGIN=http://localhost:5173

# App client origin for email links (required in production, defaults to http://localhost:5173 in dev)
APP_BASE_URL=http://localhost:5173

# SMTP Email Transport (required in production; in development, nodemailer Ethereal test account is used if omitted)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
MAIL_FROM=no-reply@homeroom.local

# Used by scripts/seedAdmin.js (SEED_ADMIN_EMAIL is required for the seed)
SEED_ADMIN_USER_ID=123456789
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_EMAIL=admin@school.local
SEED_ADMIN_FIRST_NAME=School
SEED_ADMIN_LAST_NAME=Admin